{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellDock",
  "version": "0.2.1",
  "identifier": "com.harunbulbul.shelldock",
  "build": {
    "beforeDevCommand": "npm.cmd run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShellDock",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../LICENSE": "licenses/ShellDock.txt",
      "../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../licenses/OpenSSL.txt": "licenses/OpenSSL.txt",
      "../licenses/libssh2.txt": "licenses/libssh2.txt"
    }
  }
}
